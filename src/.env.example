# Copia este archivo a ".env" (sin el ".example") y llena tus valores reales.
# .env NUNCA se sube a git (ver .gitignore) - contiene credenciales.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-algo-largo-y-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (Postgres propio, servicio "db" de docker-compose) ---
# El host es "db" (el nombre del servicio en docker-compose.yml), no
# localhost: "web" y "db" se ven entre sí por la red interna de Docker.
POSTGRES_DB=facilmodera
POSTGRES_USER=facilmodera
POSTGRES_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio
DATABASE_URL=postgresql://facilmodera:cambia-esto-por-algo-largo-y-aleatorio@db:5432/facilmodera
